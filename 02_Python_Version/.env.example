# 真实 LLM API 模式：设为 api，并仅在本地 .env 中填写密钥。
LLM_MODE=offline
# openai / responses / anthropic / gemini（工作台使用；旧 Prompt 对照脚本仍为 Chat Completions）
LLM_PROTOCOL=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=30
TAVILY_API_KEY=

# API 模式的云端语义向量（OpenAI 兼容 /embeddings，默认阿里云百炼）。
# 留空则 API 模式继续使用本地哈希向量；离线模式始终使用哈希向量。
# 启用后，资料文本块（含个人上传）和检索词会发送到该服务。
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_API_DIMENSION=1024
EMBEDDING_BATCH_SIZE=10
SEMANTIC_WEIGHT=0.7
# 语义检索的拒答阈值（text-embedding-v4 校准值）；换模型后运行 python -m src.evaluation.semantic_check 重新校准
SEMANTIC_THRESHOLD=0.40

# RAG 与 Agent 固定参数（离线哈希检索）
CHUNK_SIZE=260
CHUNK_OVERLAP=40
EMBEDDING_DIMENSION=512
TOP_K=3
SIMILARITY_THRESHOLD=0.25
MAX_AGENT_STEPS=3
MEMORY_TURNS=6
